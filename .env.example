# ============================================================
# GigLock — Root .env.example
# ============================================================
# Each package under packages/ has its OWN .env.example that is
# the source of truth for that package's runtime config. The root
# file is a reference only — do NOT `cp .env.example .env` here.
# Copy the per-package .env.example into the package directory:
#   cp packages/contracts/.env.example packages/contracts/.env
#   cp packages/relayer/.env.example    packages/relayer/.env
#   cp packages/frontend/.env.example   packages/frontend/.env.local
# ============================================================

# Shared across all packages — root-level reference only
GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io

# Forward-looking — entries below are placeholders for follow-up
# plans (indexer, IPFS, paymaster, etc.) and are NOT consumed by
# the current scaffold. They live here so a developer skimming the
# root config can see the full future surface area.
#
# GIWA_FLASHBLOCKS_RPC_URL=https://sepolia-rpc-flashblocks.giwa.io
# GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io
# GIWA_EXPLORER_API_URL=https://sepolia-explorer.giwa.io/api
# DATABASE_URL=
# WEB3_STORAGE_TOKEN=
# PINATA_JWT=
