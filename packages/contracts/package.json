{
  "name": "@giglock/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "build": "hardhat compile && tsc --noEmit",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat ignition deploy ignition/modules/GigLock.ts --network localhost",
    "deploy:giwa-testnet": "hardhat ignition deploy ignition/modules/GigLock.ts --network giwaSepolia",
    "lint": "solhint 'contracts/**/*.sol'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf artifacts cache typechain-types ignition/deployments"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.0.0",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "hardhat": "^3.8.0",
    "solhint": "^5.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "viem": "^2.21.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}
