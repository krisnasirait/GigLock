# =====================================================
# Relayer runtime env (packages/relayer/.env)
# All FILEBASE_* vars are SECRET — never commit.
# =====================================================

# --- Server ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=60

# --- Transaction relayer (set when /meta-tx ships) ---
RELAYER_PRIVATE_KEY=
RPC_URL=https://sepolia-rpc.giwa.io
CHAIN_ID=91342
MINIMAL_FORWARDER_ADDRESS=

# --- IPFS / Filebase (S3-compatible pinning) ---
# Get these from https://console.filebase.io → API Keys
# Treat as secrets — set in Render Dashboard, not here for deployed envs.
FILEBASE_ACCESS_KEY_ID=
FILEBASE_SECRET_ACCESS_KEY=
FILEBASE_BUCKET=
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=us-east-1
IPFS_GATEWAY=https://ipfs.filebase.io/ipfs/
IPFS_MAX_FILE_BYTES=10485760
